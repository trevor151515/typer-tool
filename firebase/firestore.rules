rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal writer docs: each signed-in user can only read/write their own path.
    match /typerDrafts/{uid}/files/{fileId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny all other document paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
